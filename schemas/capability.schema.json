        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "scale": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scale"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity",
          "default": "none"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "decimal",
            "boolean",
            "array"
