              },
              {
                "$ref": "#/$defs/UrlMatches"
              },
              {
                "$ref": "#/$defs/TitleMatches"
              },
              {
                "$ref": "#/$defs/OutputPresent"
              },
              {
                "$ref": "#/$defs/AllOf"
              },
              {
                "$ref": "#/$defs/AnyOf"
              },
              {
                "$ref": "#/$defs/Not"
              }
            ]
          },
          "minItems": 1,
          "title": "Any",
          "type": "array"
        }
      },
      "required": [
        "any"
      ],
      "title": "AnyOf",
      "type": "object"
    },
