          "type": "string"
        },
        "strategy": {
          "const": "a11y",
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "strategy",
        "role",
        "name"
      ],
      "title": "A11yLocator",
      "type": "object"
    },
    "AllOf": {
