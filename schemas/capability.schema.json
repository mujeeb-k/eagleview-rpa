          "type": "array"
        }
      },
      "required": [
        "all"
      ],
      "title": "AllOf",
      "type": "object"
    },
    "AnchorLocator": {
      "additionalProperties": false,
      "description": "A control in a geometric relation to visible text. Works wherever text has geometry: DOM\nranges on the web, OCR or UI Automation on desktop. `anchor_text` lists aliases.",
      "properties": {
        "anchor_text": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Anchor Text",
          "type": "array"
        },
        "control": {
          "enum": [
            "textbox",
            "button",
            "link",
            "select",
            "checkbox",
            "radio",
            "image",
            "text",
            "any"
          ],
          "title": "Control",
          "type": "string"
        },
        "relation": {
          "enum": [
            "right_of",
            "left_of",
            "below",
            "above"
          ],
          "title": "Relation",
          "type": "string"
        },
        "strategy": {
          "const": "anchor",
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "strategy",
        "anchor_text",
        "relation",
        "control"
      ],
      "title": "AnchorLocator",
      "type": "object"
    },
    "AnyOf": {
