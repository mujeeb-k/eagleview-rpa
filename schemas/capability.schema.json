            },
            {
              "$ref": "#/$defs/OutputPresent"
            },
            {
              "$ref": "#/$defs/AllOf"
            },
            {
              "$ref": "#/$defs/AnyOf"
            },
            {
              "$ref": "#/$defs/Not"
            }
