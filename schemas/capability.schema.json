        "code": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "detect": {
          "oneOf": [
            {
              "$ref": "#/$defs/TextPresent"
            },
            {
              "$ref": "#/$defs/TextMatches"
            },
            {
              "$ref": "#/$defs/ElementPresent"
            },
            {
              "$ref": "#/$defs/FieldValue"
            },
            {
              "$ref": "#/$defs/UrlMatches"
            },
            {
              "$ref": "#/$defs/TitleMatches"
            },
            {
              "$ref": "#/$defs/OutputPresent"
            },
            {
              "$ref": "#/$defs/AllOf"
            },
            {
              "$ref": "#/$defs/AnyOf"
            },
            {
              "$ref": "#/$defs/Not"
            }
          ],
          "title": "Detect"
        },
        "kind": {
          "const": "business",
          "default": "business",
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source",
          "default": "authored"
        }
      },
      "required": [
        "code",
        "detect",
        "message"
      ],
      "title": "Outcome",
      "type": "object"
    },
    "OutputPresent": {
      "additionalProperties": false,
      "properties": {
        "output_present": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Output Present",
          "type": "string"
        }
      },
      "required": [
        "output_present"
      ],
      "title": "OutputPresent",
      "type": "object"
    },
    "OutputSpec": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "items": {
          "anyOf": [
            {
              "patternProperties": {
                "^[a-z][a-z0-9_]*$": {
                  "$ref": "#/$defs/FieldSpec"
                }
